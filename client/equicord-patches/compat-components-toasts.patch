+const _showToast: any = findByCodeLazy(".currentToastMap.has(");
+export const showToast: any = (content: any, type?: any, options?: any) => {
+    if (typeof content === "object" && content !== null && !Array.isArray(content) && content.text) {
+        return _showToast(content);
+    }
+    const variant = type === "failure" || type === "error" ? "critical" : type === "success" ? "positive" : "normal";
+    return _showToast({ text: String(content ?? ""), variant, ...options });
+};
+
+export const Toasts: any = {
+    show: (opts: any) => {
+        try {
+            showToast(opts?.message ?? opts?.content ?? opts?.text ?? String(opts));
+        } catch {}
+    },
+    pop: () => {},
+    genId: () => Math.random().toString(36).slice(2),
+    Type: {
+        MESSAGE: "message",
+        SUCCESS: "success",
+        FAILURE: "failure",
+        CUSTOM: "custom"
+    }
+};
+export const createToast: any = (message: string, type?: any, options?: any) => ({ message, type, options });
 
