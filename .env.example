DOMAIN=chat.example.com
INSTANCE_NAME=FemCord
POSTGRES_PASSWORD=change-me
POSTGRES_USER=femcord
POSTGRES_DB=femcord
FEMCORD_VOLUME_PREFIX=femcord
WRTC_PUBLIC_IP=203.0.113.10
WRTC_PORT=50000

# the TURN relay that carries your users' calls in servers on other instances, so those instances never see their addresses; openssl rand -hex 32. empty turns it off and those calls are refused
TURN_SECRET=
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_RELAY_PORT_MIN=49160
TURN_RELAY_PORT_MAX=49200

# the bundled caddy service; leave empty to use your own reverse proxy on 127.0.0.1:SERVER_PORT instead
COMPOSE_PROFILES=
CADDY_GLOBAL_OPTIONS=
SERVER_PORT=3001
SERVER_BIND_IP=127.0.0.1
TRUSTED_PROXIES=

# Captcha: ENABLE_CAPTCHA=true activates the built-in Cap Core (Proof of Work / interactive challenge)
# Or configure the three standalone variables for an external Cap Standalone instance
ENABLE_CAPTCHA=true
CAP_INSTANCE_URL=
CAP_SITE_KEY=
CAP_SECRET_KEY=

TOYHOUSE_CLIENT_ID=
TOYHOUSE_CLIENT_SECRET=

LASTFM_API_KEY=
LASTFM_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

CLIENT_BASE_URL=https://canary.discord.com
CLIENT_CONCURRENCY=8
COLLECTIBLES_EXTERNAL_REFRESH=true
COLLECTIBLES_REFRESH_HOURS=24
COLLECTIBLES_CATALOG_URL=
PROFILE_EFFECTS_CATALOG_URL=
LOG_REQUESTS=500,501
REVISION=
REVISION_TIME=0

E2EE_RECOVERY_KEY_FILE=
E2EE_RECOVERY_MASTER_KEY=

# outbound fetches of user-chosen URLs (embeds, media proxy, webhook avatars) go through this socks5 proxy so the server's address stays hidden; compose runs a cloudflare warp container for it. "direct" turns this off.
PUBLIC_FETCH_PROXY=direct
WARP_LICENSE_KEY=
